# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- Deployment (Step 2: X Layer Testnet, chain 1952) ---

# Deploys and OWNS the contracts. Fund with testnet OKB from
# https://web3.okx.com/xlayer/faucet (0.2 OKB/day, connect on chain 1952 first).
DEPLOYER_PRIVATE_KEY=

# The agent role's ADDRESS only — never its private key. The deploy script
# rejects an agent address equal to the deployer, since the owner can rotate
# the agent and one key holding both roles would collapse that separation.
# Generate a fresh keypair: cast wallet new
AGENT_ADDRESS=

# EmergencyVault time lock in seconds. Defaults to 86400 (1 day) if unset.
EMERGENCY_CLAIM_DELAY=86400

# Explorer API key for contract verification.
#
# NOT REQUIRED FOR X LAYER TESTNET. OKLink's verify-source-code-plugin route for
# XLAYER_TESTNET does not validate this value — a contract was successfully
# verified using a deliberately invalid key. Foundry's CLI still demands the
# flag, so scripts\verify-testnet.cmd falls back to OKX_API_KEY when this is
# empty. Mainnet (XLAYER) is untested; get a real key before relying on it there.
OKLINK_API_KEY=


# --- Agent behaviour ---

# Minimum seconds between two agent-initiated exits on the SAME position.
# Defaults to 900 (15 min) if unset.
#
# Why this exists: a depressed price keeps satisfying "drawdown > X%" on every
# pass, so without a floor the agent exits again each poll and compounds one
# user instruction into many. Caught on testnet draining a position
# 200 -> 100 -> 50 in consecutive passes. The agent still re-acts when the
# decline genuinely deepens, or immediately after a recovery.
# EXIT_COOLDOWN_SECONDS=900


# --- Phase 2: OKX DEX ---

# All four are required together, or the integration stays off. Used ONLY for
# read-only price quotes, which provide the independent reference price for the
# oracle-deviation check. These credentials sign API requests, not
# transactions — they cannot move funds.
#
# NOTE: the agent reads agent/.env FIRST, then this root .env. Either location
# works; agent/.env is the natural home for agent-only secrets. Both are
# gitignored.
OKX_API_KEY=
# OKX's portal labels this "Secret Key". Either name is accepted.
OKX_API_SECRET=
OKX_API_PASSPHRASE=
OKX_PROJECT_ID=

# Quote denominator for the reference price. Defaults to real X Layer mainnet
# USDC; override only if quoting against a different stablecoin.
# OKX_QUOTE_TOKEN_ADDRESS=0x74b7F16337b8972027F6196A17a631aC6dE26d22
# OKX_QUOTE_TOKEN_DECIMALS=6

# IMPORTANT: the OKX DEX aggregator indexes MAINNET liquidity only (chainIndex
# 196). On testnet (AEGIS_NETWORK=testnet) quotes are disabled and the
# deviation check is skipped — drawdown and volatility checks still run.
