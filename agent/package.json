{
  "name": "aegis-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Aegis off-chain risk agent — monitors positions on X Layer, evaluates risk, and acts only within the policy each user approved on-chain.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "parse": "tsx src/cli/parse-policy.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@okx-dex/okx-dex-sdk": "1.0.19",
    "dotenv": "^16.4.5",
    "viem": "^2.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
